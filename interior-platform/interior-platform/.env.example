# ============================================
# COPY THIS FILE TO ".env" AND FILL IN REAL VALUES
# Never commit the real .env file.
# ============================================

# --- App ---
ENV=production
DEBUG=false
APP_NAME="Aetherlume Interiors Platform"

# --- Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))") ---
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET_KEY=CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
POSTGRES_USER=aetherlume
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=aetherlume_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aetherlume:CHANGE_ME_STRONG_PASSWORD@db:5432/aetherlume_db

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# --- File storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,webp,gif,pdf,dwg,skp

# Only needed if STORAGE_BACKEND=s3
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# --- Email ---
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDGRID_API_KEY=

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
